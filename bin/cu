#!/usr/bin/env node
/* Fast ClickUp CLI for daily workflow. No deps. */
const fs = require('fs');
const os = require('os');
const path = require('path');

const CLI = 'cu';
const API = 'https://api.clickup.com/api/v2';
const CONFIG_DIR = path.join(os.homedir(), '.config', 'cu');
const CONFIG_PATH = path.join(CONFIG_DIR, 'config.json');
const TOKEN_PATH = path.join(CONFIG_DIR, 'token');
const CLICKUP_COLORS = {
  dark: [41, 45, 52],       // #292D34
  purple: [123, 104, 238],  // #7B68EE
  pink: [253, 113, 175],    // #FD71AF
  blue: [73, 204, 249],     // #49CCF9
  yellow: [255, 200, 0],    // #FFC800
};
const COLOR = !process.env.NO_COLOR && !process.env.CU_PLAIN && process.env.TERM !== 'dumb' && (process.stdout.isTTY || process.stderr.isTTY);
const RESET = '\x1b[0m';

function ansi(code, text) { return COLOR ? `\x1b[${code}m${text}${RESET}` : String(text); }
function rgb(name, text) { return ansi(`38;2;${CLICKUP_COLORS[name].join(';')}`, text); }
function bg(name, text) { return ansi(`48;2;${CLICKUP_COLORS[name].join(';')};38;2;255;255;255`, text); }
const ui = {
  bold: (s) => ansi('1', s),
  dim: (s) => ansi('2', s),
  dark: (s) => rgb('dark', s),
  purple: (s) => rgb('purple', s),
  pink: (s) => rgb('pink', s),
  blue: (s) => rgb('blue', s),
  yellow: (s) => rgb('yellow', s),
  darkBg: (s) => bg('dark', s),
  purpleBg: (s) => bg('purple', s),
  pinkBg: (s) => bg('pink', s),
  blueBg: (s) => bg('blue', s),
  yellowBg: (s) => COLOR ? `\x1b[48;2;255;200;0;38;2;41;45;52m${s}${RESET}` : String(s),
};

function readTokenFile() {
  try { return fs.readFileSync(TOKEN_PATH, 'utf8').trim(); } catch {}
  return '';
}
const ENV_TOKEN = process.env.CLICKUP_API_TOKEN || process.env.CLICKUP_TOKEN || '';
const FILE_TOKEN = readTokenFile();
const TOKEN = ENV_TOKEN || FILE_TOKEN;

function brandMark() {
  return `${ui.purple('c')}${ui.pink('u')}`;
}
function divider(width = 62) {
  const chunk = Math.max(8, Math.floor(width / 4));
  return ui.purple('─'.repeat(chunk)) + ui.pink('─'.repeat(chunk)) + ui.blue('─'.repeat(chunk)) + ui.yellow('─'.repeat(width - chunk * 3));
}
function header(title, subtitle) {
  console.log(`\n${brandMark()} ${ui.bold(safe(title))}`);
  if (subtitle) console.log(`   ${ui.dim(safe(subtitle))}`);
  console.log(divider());
}
function section(title, count, accent = 'purple') {
  const meta = count === undefined ? '' : ui.dim(` ${count}`);
  console.log(`\n${ui[accent]('◆')} ${ui.bold(title)}${meta}`);
}
function pill(text, accent = 'purple') {
  const clean = String(text || '').trim();
  if (!clean) return '';
  const label = ` ${clean.toUpperCase()} `;
  if (accent === 'yellow') return ui.yellowBg(label);
  if (accent === 'pink') return ui.pinkBg(label);
  if (accent === 'blue') return ui.blueBg(label);
  if (accent === 'dark') return ui.darkBg(label);
  return ui.purpleBg(label);
}
function success(message, detail) {
  console.log(`${ui.blue('✓')} ${ui.bold(safe(message))}`);
  if (detail) console.log(`  ${ui.dim(safe(detail))}`);
}
function cleanText(value) {
  return String(value ?? '')
    .replace(/[\u001B\u009B][[\]()#;?]*(?:(?:(?:[a-zA-Z\d]*(?:;[a-zA-Z\d]*)*)?\u0007)|(?:(?:\d{1,4}(?:;\d{0,4})*)?[\dA-PR-TZcf-nq-uy=><~]))/g, '')
    .replace(/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]/g, '');
}
function safe(value, max) {
  const s = cleanText(value);
  return max ? compact(s, max) : s;
}
function note(message) { console.log(`${ui.yellow('→')} ${safe(message)}`); }
function die(msg, code = 1) {
  console.error(`\n${ui.pink('✕')} ${ui.bold(`${CLI} error`)}`);
  console.error(`  ${safe(msg)}`);
  console.error(`  ${ui.dim('Help:')} ${ui.blue(`${CLI} help`)}\n`);
  process.exit(code);
}
function readConfig() {
  try { return JSON.parse(fs.readFileSync(CONFIG_PATH, 'utf8')); } catch {}
  return {};
}
const cfg = readConfig();
const DEFAULT_STATUSES = {
  backlog: 'BACKLOG',
  todo: 'TO-DO',
  start: 'IN PROGRESS',
  review: 'REVIEW',
  qa: 'QA/TESTING',
  blocked: 'BLOCKED',
  release: 'READY FOR RELEASE',
  done: 'DONE',
};
function configuredStatus(key) {
  return cfg.statuses?.[key] || DEFAULT_STATUSES[key];
}

function requireToken() {
  if (!TOKEN) die(`missing ClickUp token. Run: cu token pk_xxx  or export CLICKUP_API_TOKEN="pk_xxx"`);
}
function requireWorkspace() {
  if (!cfg.workspaceId) die(`missing workspaceId in ${CONFIG_PATH}. Run: cu init`);
  return String(cfg.workspaceId);
}
function requireUser() {
  if (!cfg.userId) die(`missing userId in ${CONFIG_PATH}. Run: cu init`);
  return String(cfg.userId);
}

async function apiResult(method, endpoint, body) {
  requireToken();
  const res = await fetch(`${API}${endpoint}`, {
    method,
    headers: {
      Authorization: TOKEN,
      'Content-Type': 'application/json',
    },
    body: body === undefined ? undefined : JSON.stringify(body),
  });
  const text = await res.text();
  let json = null;
  try { json = text ? JSON.parse(text) : {}; } catch { json = { raw: text }; }
  if (!res.ok) {
    const err = cleanText(json?.err || json?.ECODE || json?.raw || `${res.status} ${res.statusText}`);
    throw new Error(`${method} ${endpoint} failed: ${err}`);
  }
  return json;
}
async function api(method, endpoint, body) {
  try { return await apiResult(method, endpoint, body); }
  catch (e) { die(e?.message || String(e)); }
}

const qs = (params) => {
  const out = [];
  for (const [k, v] of Object.entries(params)) {
    if (v === undefined || v === null || v === '') continue;
    if (Array.isArray(v)) for (const x of v) out.push(`${encodeURIComponent(k)}=${encodeURIComponent(x)}`);
    else out.push(`${encodeURIComponent(k)}=${encodeURIComponent(v)}`);
  }
  return out.length ? `?${out.join('&')}` : '';
};
const statusName = (t) => safe(typeof t.status === 'string' ? t.status : (t.status?.status || 'unknown'));
const prio = (t) => safe(typeof t.priority === 'string' ? t.priority : (t.priority?.priority || t.priority || ''));
const due = (t) => t.due_date ? new Date(Number(t.due_date)).toISOString().slice(0,10) : '';
const shortList = (t) => safe(t.list?.name || '');
const taskUrl = (id) => `https://app.clickup.com/t/${id}`;
function fmtDuration(ms) {
  ms = Math.max(0, Number(ms) || 0);
  const h = Math.floor(ms / 3600000);
  const m = Math.round((ms % 3600000) / 60000);
  if (h && m) return `${h}h ${m}m`;
  if (h) return `${h}h`;
  return `${m}m`;
}
function parseDuration(parts) {
  const s = Array.isArray(parts) ? parts.join(' ') : String(parts || '');
  const re = /(\d+(?:\.\d+)?)\s*(h|hr|hrs|hour|hours|m|min|mins|minute|minutes)/gi;
  let ms = 0, match;
  while ((match = re.exec(s))) {
    const n = Number(match[1]);
    const u = match[2].toLowerCase();
    ms += u.startsWith('h') ? n * 3600000 : n * 60000;
  }
  if (!ms && /^\d+$/.test(s.trim())) ms = Number(s.trim()) * 60000;
  if (!ms) die(`could not parse duration: ${s}`);
  return Math.round(ms);
}
function statusAccent(status) {
  const st = String(status || '').toLowerCase();
  if (st.includes('blocked')) return 'pink';
  if (st.includes('review') || st.includes('qa') || st.includes('testing')) return 'blue';
  if (st.includes('done') || st.includes('release') || st.includes('ready')) return 'yellow';
  if (st.includes('progress')) return 'purple';
  return 'dark';
}
function compact(text, max = 88) {
  const s = String(text || '').replace(/\s+/g, ' ').trim();
  return s.length > max ? `${s.slice(0, max - 1)}…` : s;
}
function taskMeta(t) {
  return [
    ui.blue(safe(t.id)),
    prio(t) ? ui.pink(prio(t)) : '',
    due(t) ? `${ui.yellow('due')} ${due(t)}` : '',
    shortList(t) ? ui.dim(shortList(t)) : '',
  ].filter(Boolean).join(ui.dim(' • '));
}
function taskRow(t, i) {
  const st = statusName(t);
  const accent = statusAccent(st);
  console.log(`  ${ui.dim(String(i || '').padStart(2))} ${pill(st, accent)} ${ui.bold(safe(t.name || 'Untitled task', 80))}`);
  console.log(`     ${taskMeta(t)}`);
  console.log(`     ${ui.blue(safe(t.url || taskUrl(t.id)))}`);
}
function humanLine(t, i) {
  const bits = [statusName(t), prio(t), due(t) ? `due ${due(t)}` : '', shortList(t)].filter(Boolean);
  return `${i ? `${i}. ` : ''}${safe(t.id)} — ${safe(t.name)}\n   ${bits.join(' · ')}\n   ${safe(t.url || taskUrl(t.id))}`;
}
async function getTask(id) { return api('GET', `/task/${encodeURIComponent(id)}`); }
async function updateTask(id, body) { return api('PUT', `/task/${encodeURIComponent(id)}`, body); }
async function listTasks({ all = false, status, page = 0 } = {}) {
  const team = requireWorkspace();
  const includeClosed = status && status.toLowerCase() === configuredStatus('done').toLowerCase();
  const params = { include_closed: includeClosed ? 'true' : 'false', subtasks: 'true', page };
  if (!all) params['assignees[]'] = requireUser();
  if (status) params['statuses[]'] = status;
  const data = await api('GET', `/team/${team}/task${qs(params)}`);
  return data.tasks || [];
}
async function currentTimer() {
  const team = requireWorkspace();
  return api('GET', `/team/${team}/time_entries/current`);
}
async function startTimer(id) {
  const team = requireWorkspace();
  return api('POST', `/team/${team}/time_entries/start`, { tid: id });
}
async function stopTimer() {
  const team = requireWorkspace();
  return api('POST', `/team/${team}/time_entries/stop`, {});
}
async function addTime(id, durationMs, noteText) {
  const team = requireWorkspace();
  const end = Date.now();
  const start = end - durationMs;
  return api('POST', `/team/${team}/time_entries`, { tid: id, start, duration: durationMs, description: noteText || '' });
}
async function createTask(listId, body) { return api('POST', `/list/${encodeURIComponent(listId)}/task`, body); }

function groupTasks(tasks) {
  const today = new Date().toISOString().slice(0,10);
  const groups = { due: [], active: [], blocked: [], notStarted: [], other: [] };
  for (const t of tasks) {
    const st = statusName(t).toLowerCase();
    if (due(t) && due(t) <= today) groups.due.push(t);
    else if (st.includes('blocked')) groups.blocked.push(t);
    else if (st.includes('progress') || st.includes('review') || st.includes('qa') || st.includes('testing') || st.includes('ready') || st.includes('release')) groups.active.push(t);
    else if (st.includes('backlog') || st.includes('to-do') || st.includes('todo') || st.includes('not started')) groups.notStarted.push(t);
    else groups.other.push(t);
  }
  return groups;
}
function printGroup(title, arr, startIndex, accent = 'purple') {
  if (!arr.length) return startIndex;
  section(title, arr.length, accent);
  arr.forEach((t, idx) => taskRow(t, startIndex + idx));
  return startIndex + arr.length;
}

async function cmdToday() {
  header('Today', 'Timer, priority work, and next ClickUp moves');
  let cur = null;
  try { cur = await currentTimer(); } catch (e) { cur = { data: null }; }
  const entry = cur.data || cur.currentEntry || cur;
  section('Running now', undefined, 'blue');
  if (entry && (entry.task || entry.tid) && (entry.duration < 0 || entry.start)) {
    const start = Number(entry.start);
    const elapsed = entry.duration < 0 ? Math.abs(Number(entry.duration)) : Date.now() - start;
    const task = entry.task || {};
    console.log(`  ${ui.purple('●')} ${ui.bold(safe(task.name || entry.description || 'active timer'))}`);
    console.log(`     ${ui.blue(task.id || entry.tid || '')} ${ui.dim('•')} ${ui.yellow(fmtDuration(elapsed))}`);
  } else {
    console.log(`  ${ui.dim('No active timer.')}`);
  }
  const tasks = await listTasks();
  const g = groupTasks(tasks);
  let i = 1;
  i = printGroup('Due / overdue', g.due, i, 'yellow');
  i = printGroup('Active', g.active, i, 'purple');
  i = printGroup('Blocked', g.blocked, i, 'pink');
  i = printGroup('Not started', g.notStarted, i, 'blue');
  i = printGroup('Other', g.other, i, 'dark');
  if (i === 1) console.log(`\n${ui.blue('✓')} ${ui.bold('No open tasks found.')}`);
  section('Next moves', undefined, 'yellow');
  console.log(`  ${ui.blue('cu start <id>')} ${ui.dim('•')} ${ui.blue('cu show <id>')} ${ui.dim('•')} ${ui.blue('cu stop')} ${ui.dim('•')} ${ui.blue('cu release <id>')} ${ui.dim('•')} ${ui.blue('cu done <id>')}`);
}
async function cmdList(args) {
  const all = args.includes('all');
  const statusIdx = args.indexOf('status');
  const status = statusIdx >= 0 ? args.slice(statusIdx + 1).join(' ') : undefined;
  const tasks = await listTasks({ all, status });
  header('Tasks', `${tasks.length} task(s)${status ? ` with status ${safe(status)}` : ''}${all ? ' across workspace' : ' assigned to you'}`);
  if (!tasks.length) return success('Nothing to show.');
  tasks.forEach((t, i) => taskRow(t, i + 1));
}
async function cmdShow(id) {
  if (!id) die('usage: cu show <task-id>');
  const t = await getTask(id);
  header(safe(t.name || 'Task', 72), safe(t.id));
  taskRow(t, '');
  section('Details', undefined, 'blue');
  console.log(`  ${ui.dim('Assignees')}  ${safe((t.assignees || []).map(a => a.username || a.email || a.id).join(', ') || 'none')}`);
  console.log(`  ${ui.dim('Estimate')}   ${t.time_estimate ? ui.yellow(fmtDuration(Number(t.time_estimate))) : 'none'}`);
  console.log(`  ${ui.dim('Spent')}      ${t.time_spent ? ui.purple(fmtDuration(Number(t.time_spent))) : '0m'}`);
  if (t.parent) console.log(`  ${ui.dim('Parent')}     ${t.parent}`);
  if (t.description || t.text_content) {
    section('Description', undefined, 'purple');
    console.log(`  ${safe((t.description || t.text_content).slice(0, 800), 800)}`);
  }
}
async function cmdSetStatus(id, key, label = key) {
  if (!id) die(`usage: cu ${label} <task-id>`);
  const st = configuredStatus(key);
  const t = await updateTask(id, { status: st });
  success(`${label} ${id}`, `${statusName(t)} • ${t.url || taskUrl(id)}`);
}
async function cmdStart(id) {
  if (!id) die('usage: cu start <task-id>');
  let statusMsg = '';
  const st = configuredStatus('start');
  try { await updateTask(id, { status: st }); statusMsg = `status ${st}`; }
  catch (e) { statusMsg = 'status unchanged'; }
  const out = await startTimer(id);
  const task = out.data?.task || out.timeEntry?.task || out.task || await getTask(id).catch(() => ({ id }));
  success(`Started ${safe(id)}`, `${safe(task.name || '')}`.trim());
  note(`Timer active • ${statusMsg}`);
  console.log(`  ${ui.blue(safe(taskUrl(id)))}`);
}
async function cmdStop() {
  const out = await stopTimer();
  const e = out.data || out.timeEntry || out;
  const task = e.task || {};
  const duration = e.duration_ms || e.duration || (e.start && e.end ? Number(e.end) - Number(e.start) : 0);
  success(`Stopped ${safe(task.id || '')} ${task.name ? `— ${safe(task.name)}` : ''}`.trim(), `Duration: ${typeof duration === 'string' && !/^\d+$/.test(duration) ? safe(duration) : fmtDuration(duration)}`);
}
async function cmdDone(id) {
  return cmdSetStatus(id, 'done', 'done');
}
async function cmdEstimate(args) {
  const id = args[0];
  if (!id || args.length < 2) die('usage: cu estimate <task-id> <duration>');
  const ms = parseDuration(args.slice(1));
  const t = await updateTask(id, { time_estimate: ms });
  success(`Estimate set ${id}`, `${fmtDuration(ms)} • ${t.url || taskUrl(id)}`);
}
async function cmdAddTime(args) {
  const id = args[0];
  if (!id || args.length < 2) die('usage: cu addtime <task-id> <duration> [note]');
  const durationText = [];
  let i = 1;
  for (; i < args.length; i++) { durationText.push(args[i]); if (/[hm]/i.test(args[i])) break; }
  const ms = parseDuration(durationText);
  const noteText = args.slice(i + 1).join(' ');
  await addTime(id, ms, noteText);
  success(`Added time ${safe(id)}`, `${fmtDuration(ms)}${noteText ? ` • ${safe(noteText)}` : ''}`);
}
async function cmdCreate(args) {
  const listId = cfg.defaultListId;
  if (!listId) die(`missing defaultListId in ${CONFIG_PATH}`);
  const name = args.join(' ').trim();
  if (!name) die('usage: cu create <task title>');
  const t = await createTask(listId, { name });
  success(`Created ${t.id}`, t.name);
  console.log(`  ${ui.blue(safe(t.url || taskUrl(t.id)))}`);
}
async function cmdSubtask(args) {
  const parent = args[0];
  const name = args.slice(1).join(' ').trim();
  if (!parent || !name) die('usage: cu subtask <parent-task-id> <title>');
  const p = await getTask(parent);
  const listId = p.list?.id || cfg.defaultListId;
  const t = await createTask(listId, { name, parent });
  success(`Created subtask ${t.id}`, t.name);
  console.log(`  ${ui.blue(safe(t.url || taskUrl(t.id)))}`);
}
async function cmdAssign(args) {
  const id = args[0];
  if (!id || args.length < 2) die('usage: cu assign <task-id> <user-id...>  # use numeric user IDs');
  const users = args.slice(1).map(x => x === 'me' ? Number(requireUser()) : Number(x)).filter(Boolean);
  if (!users.length) die('assign currently needs numeric user IDs or me');
  const t = await getTask(id);
  const existing = (t.assignees || []).map(a => Number(a.id));
  const merged = [...new Set([...existing, ...users])];
  const out = await updateTask(id, { assignees: merged });
  success(`Assigned ${id}`, `${merged.join(', ')} • ${out.url || taskUrl(id)}`);
}
const usefulValue = (v) => v && String(v).trim() && String(v).trim() !== 'test' ? String(v).trim() : '';
async function discoverFirstListId(teamId) {
  if (!teamId) return '';
  try {
    const spacesData = await apiResult('GET', `/team/${encodeURIComponent(teamId)}/space${qs({ archived: 'false' })}`);
    for (const space of spacesData.spaces || []) {
      try {
        const direct = await apiResult('GET', `/space/${encodeURIComponent(space.id)}/list${qs({ archived: 'false' })}`);
        const list = (direct.lists || [])[0];
        if (list?.id) return String(list.id);
      } catch {}
      try {
        const folders = await apiResult('GET', `/space/${encodeURIComponent(space.id)}/folder${qs({ archived: 'false' })}`);
        for (const folder of folders.folders || []) {
          try {
            const nested = await apiResult('GET', `/folder/${encodeURIComponent(folder.id)}/list${qs({ archived: 'false' })}`);
            const list = (nested.lists || [])[0];
            if (list?.id) return String(list.id);
          } catch {}
        }
      } catch {}
    }
  } catch {}
  return '';
}
async function discoverConfig() {
  const found = { workspaceId: '', userId: '', defaultListId: '' };
  if (!TOKEN) return found;
  try {
    const user = await apiResult('GET', '/user');
    if (user?.user?.id) found.userId = String(user.user.id);
  } catch {}
  try {
    const teams = await apiResult('GET', '/team');
    const list = teams.teams || [];
    const preferred = usefulValue(cfg.workspaceId);
    const team = list.find(t => String(t.id) === preferred) || list[0];
    if (team?.id) found.workspaceId = String(team.id);
    if (!found.userId && team?.members?.length === 1 && team.members[0]?.user?.id) {
      found.userId = String(team.members[0].user.id);
    }
  } catch {}
  found.defaultListId = usefulValue(cfg.defaultListId) || await discoverFirstListId(found.workspaceId);
  return found;
}
async function cmdInit() {
  fs.mkdirSync(path.dirname(CONFIG_PATH), { recursive: true });
  const discovered = await discoverConfig();
  const sample = {
    workspaceId: usefulValue(cfg.workspaceId) || discovered.workspaceId,
    userId: usefulValue(cfg.userId) || discovered.userId,
    defaultListId: usefulValue(cfg.defaultListId) || discovered.defaultListId,
    statuses: { ...DEFAULT_STATUSES, ...(cfg.statuses || {}) }
  };
  const shouldWrite = !fs.existsSync(CONFIG_PATH)
    || !usefulValue(cfg.workspaceId)
    || !usefulValue(cfg.userId)
    || !usefulValue(cfg.defaultListId);
  if (shouldWrite) fs.writeFileSync(CONFIG_PATH, JSON.stringify(sample, null, 2) + '\n', { mode: 0o600 });
  try { fs.chmodSync(CONFIG_PATH, 0o600); } catch {}
  header('Config', CONFIG_PATH);
  console.log(cleanText(fs.readFileSync(CONFIG_PATH, 'utf8')));
  if (!TOKEN) note(`Set token first for auto-discovery: ${ui.blue('cu token pk_xxx')}`);
  else if (!sample.workspaceId || !sample.userId) note('Could not auto-discover all IDs. Check token permissions or set missing values manually.');
  else if (!sample.defaultListId) note('Workspace/user detected. Set defaultListId manually if you want cu create.');
  console.log(`  ${ui.dim(`Token stored at ${TOKEN_PATH}`)}`);
}
function cmdToken(token) {
  if (!token || !token.startsWith('pk_')) die('usage: cu token pk_xxx');
  const clean = token.trim();
  fs.mkdirSync(path.dirname(TOKEN_PATH), { recursive: true });
  fs.writeFileSync(TOKEN_PATH, clean + '\n', { mode: 0o600 });
  try { fs.chmodSync(TOKEN_PATH, 0o600); } catch {}
  success('Token saved', TOKEN_PATH);
  if (ENV_TOKEN && ENV_TOKEN !== clean) {
    note('A different CLICKUP_API_TOKEN/CLICKUP_TOKEN is exported and will override this file token. Update your shell profile or unset it.');
  }
}
function helpLine(command, desc) {
  console.log(`  ${ui.blue(command.padEnd(32))} ${desc}`);
}
function help() {
  header('ClickUp CLI', 'Fast daily task control from terminal or Pi');
  section('Daily', undefined, 'purple');
  helpLine('cu today', 'Dashboard: timer + my open tasks');
  helpLine('cu list [all|status X]', 'List tasks');
  helpLine('cu show <id>', 'Show task details');
  section('Workflow statuses', undefined, 'blue');
  helpLine('cu backlog <id>', 'Set BACKLOG');
  helpLine('cu todo <id>', 'Set TO-DO');
  helpLine('cu start <id>', 'Set IN PROGRESS + start timer');
  helpLine('cu progress <id>', 'Set IN PROGRESS without timer');
  helpLine('cu review <id>', 'Set REVIEW');
  helpLine('cu qa | testing <id>', 'Set QA/TESTING');
  helpLine('cu blocked <id>', 'Set BLOCKED');
  helpLine('cu release <id>', 'Set READY FOR RELEASE');
  helpLine('cu done <id>', 'Set DONE');
  section('Time', undefined, 'yellow');
  helpLine('cu stop', 'Stop current timer');
  helpLine('cu estimate <id> <dur>', 'Set estimate (2h, 30m, 2h 30m)');
  helpLine('cu addtime <id> <dur> [note]', 'Add manual time entry');
  section('Create/update', undefined, 'pink');
  helpLine('cu create <title>', 'Create in default list');
  helpLine('cu subtask <parent> <title>', 'Create subtask');
  helpLine('cu assign <id> <user-id|me...>', 'Add assignees');
  section('Setup', undefined, 'purple');
  helpLine('cu init', 'Create/show config');
  helpLine('cu token <pk_xxx>', 'Save token locally');
  console.log(`\n${ui.dim('Configured status keys:')} backlog, todo, start, review, qa, blocked, release, done`);
  console.log(`${ui.dim('Config:')} ${CONFIG_PATH}`);
  console.log(`${ui.dim('Token:')}  CLICKUP_API_TOKEN or ${TOKEN_PATH}`);
  console.log(`${ui.dim('Plain output:')} NO_COLOR=1 cu today  or  CU_PLAIN=1 cu today\n`);
}

(async () => {
  const [cmd = 'today', ...args] = process.argv.slice(2);
  try {
    if (cmd === 'help' || cmd === '--help' || cmd === '-h') return help();
    if (cmd === 'init' || cmd === 'config') return await cmdInit();
    if (cmd === 'token') return cmdToken(args[0]);
    if (cmd === 'today') return await cmdToday();
    if (cmd === 'list') return await cmdList(args);
    if (cmd === 'show') return await cmdShow(args[0]);
    if (cmd === 'start' || cmd === 'run') return await cmdStart(args[0]);
    if (cmd === 'stop') return await cmdStop();
    if (cmd === 'backlog') return await cmdSetStatus(args[0], 'backlog', 'backlog');
    if (cmd === 'todo') return await cmdSetStatus(args[0], 'todo', 'todo');
    if (cmd === 'progress') return await cmdSetStatus(args[0], 'start', 'progress');
    if (cmd === 'review') return await cmdSetStatus(args[0], 'review', 'review');
    if (cmd === 'qa' || cmd === 'testing') return await cmdSetStatus(args[0], 'qa', 'qa');
    if (cmd === 'blocked') return await cmdSetStatus(args[0], 'blocked', 'blocked');
    if (cmd === 'release') return await cmdSetStatus(args[0], 'release', 'release');
    if (cmd === 'done') return await cmdDone(args[0]);
    if (cmd === 'estimate') return await cmdEstimate(args);
    if (cmd === 'addtime' || cmd === 'time') return await cmdAddTime(args);
    if (cmd === 'create') return await cmdCreate(args);
    if (cmd === 'subtask') return await cmdSubtask(args);
    if (cmd === 'assign') return await cmdAssign(args);
    die(`unknown command: ${cmd}. Run cu help`);
  } catch (e) {
    die(e?.message || String(e));
  }
})();
